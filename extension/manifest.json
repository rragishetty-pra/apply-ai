{
  "manifest_version": 3,
  "name": "Apply.ai \u2014 Hunter",
  "version": "0.4.8",
  "description": "Lets Apply.ai's Hunter agent search Naukri, LinkedIn and Indeed from your own signed-in Chrome. Your passwords never leave your browser.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://media.licdn.com/*",
    "https://www.naukri.com/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.com/*",
    "https://*.glassdoor.co.in/*",
    "https://www.ambitionbox.com/*",
    "https://www.foundit.in/*",
    "https://www.shine.com/*",
    "https://www.hirist.tech/*",
    "https://www.instahyre.com/*",
    "https://cutshort.io/*",
    "https://wellfound.com/*",
    "https://www.iimjobs.com/*",
    "https://apply-ai-kohl.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apply.ai",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://apply-ai-kohl.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
